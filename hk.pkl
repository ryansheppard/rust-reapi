amends "package://github.com/jdx/hk/releases/download/v1.57.0/hk@1.57.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.57.0/hk@1.57.0#/Builtins.pkl"
import "package://github.com/jdx/hk/releases/download/v1.57.0/hk@1.57.0#/Config.pkl"

local linters = new Mapping<String, Step> {
    // TODO: https://github.com/jdx/hk/pull/1310 Update hk once this is in a cut version
    ["cargo-check"] {
        glob = "**/*.rs"
        check = new Config.CommandSpec {
            command = "cargo check --quiet"
            effect = "write"
        }
        fix = new Config.CommandSpec {
            command = "cargo fix --allow-dirty --allow-staged --quiet"
            effect = "write"
        }
        env {
            ["CARGO_TERM_COLOR"] = "{% if color %}always{% else %}never{% endif %}"
            ["CARGO_BUILD_WARNINGS"] = "deny"
        }
    }
    ["cargo-fmt"] = Builtins.cargo_fmt
    ["cargo-clippy"] = Builtins.cargo_clippy
    ["buildifier-format"] = Builtins.buildifier_format
    ["buildifier-lint"] = Builtins.buildifier_lint
    ["yamllint"] = Builtins.yamllint
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
